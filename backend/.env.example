# Copy to .env and fill in. Nothing here is required to run in DEMO_MODE.

# --- Clerk (session-token auth) ---
# Leave both blank to use `Bearer demo-farmer` / `Bearer demo-officer` tokens
# instead. Prefer CLERK_JWT_KEY (networkless RS256 verification — no request
# to Clerk on the hot path): Dashboard -> API keys -> "Show JWT public key" ->
# PEM Public Key. CLERK_SECRET_KEY is a fallback that fetches JWKS remotely.
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
# Flutter client only — Dashboard -> API keys -> Publishable key (pk_test_...).
CLERK_PUBLISHABLE_KEY=
# Comma-separated allowed frontend origins (checked against the `azp` claim),
# e.g. http://localhost:3000,https://app.farmsync.example
CLERK_AUTHORIZED_PARTIES=

# --- Supabase (Postgres/PostGIS persistence only — auth is Clerk, above) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role secret (Dashboard -> Settings -> API -> "service_role"). Only
# used server-side to write to the private raster Storage bucket below —
# never expose this to the Flutter app. Leave blank to disable raster uploads.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres+PostGIS DSN — use the Supavisor *pooler* URI (Dashboard -> Connect
# -> "Transaction pooler"), not the direct db.<ref>.supabase.co host: that
# host is IPv6-only and fails to resolve on most networks.
# e.g. postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Defaults to a local SQLite file (backend/data/farmsync.db) if unset.
DATABASE_URL=

# --- Google Earth Engine (Sentinel-2 NDVI) ---
# Requires a GEE *service account JSON key file path* (not a Google API key);
# leave blank to run signals in "degraded" mode (soil + weather only).
GEE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# --- Raster uploads (drone/orthomosaic NDVI GeoTIFFs) ---
# Private Supabase Storage bucket that holds the uploaded .tif bytes; metadata
# lives in the raster_assets table. Create this bucket once in the dashboard.
RASTER_BUCKET=field-rasters
# Weight on the uploaded raster vs. GEE Sentinel-2 when blending NDVI (0..1).
RASTER_NDVI_BLEND_WEIGHT=0.5
RASTER_MAX_UPLOAD_MB=150

# --- Model / quantum runtime ---
MODEL_VERSION=v1
DEMO_MODE=false
QAOA_TIMEOUT_S=10.0
QAOA_LAYERS=3
ENCODING=slack
