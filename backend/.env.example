# Copy to .env and fill in. Only DATABASE_URL and the Clerk keys are needed to
# boot; everything else degrades gracefully or is optional.

# --- Clerk (session-token auth) ---
# Leave both blank to use `Bearer demo-farmer` / `Bearer demo-officer` tokens
# instead. Prefer CLERK_JWT_KEY (networkless RS256 verification — no request
# to Clerk on the hot path): Dashboard -> API keys -> "Show JWT public key" ->
# PEM Public Key. CLERK_SECRET_KEY is a fallback that fetches JWKS remotely.
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
# Flutter client only — Dashboard -> API keys -> Publishable key (pk_test_...).
CLERK_PUBLISHABLE_KEY=
# Comma-separated allowed frontend origins (checked against the `azp` claim),
# e.g. http://localhost:3000,https://app.farmsync.example
CLERK_AUTHORIZED_PARTIES=

# --- Supabase (Postgres/PostGIS persistence only — auth is Clerk, above) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role secret (Dashboard -> Settings -> API -> "service_role"). Only
# used server-side to write to the private raster Storage bucket below —
# never expose this to the Flutter app. Leave blank to disable raster uploads.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres+PostGIS DSN — use the Supavisor *pooler* URI (Dashboard -> Connect
# -> "Transaction pooler"), not the direct db.<ref>.supabase.co host: that
# host is IPv6-only and fails to resolve on most networks.
# e.g. postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Defaults to a local SQLite file (backend/data/farmsync.db) if unset.
DATABASE_URL=

# --- Google Earth Engine (Sentinel-2 NDVI) ---
# Requires a GEE *service account JSON key file path* (not a Google API key);
# leave blank to run signals in "degraded" mode (soil + weather only).
GEE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# --- Raster uploads (drone/orthomosaic NDVI GeoTIFFs) ---
# Private Supabase Storage bucket that holds the uploaded .tif bytes; metadata
# lives in the raster_assets table. Create this bucket once in the dashboard.
RASTER_BUCKET=field-rasters
# Weight on the uploaded raster vs. GEE Sentinel-2 when blending NDVI (0..1).
RASTER_NDVI_BLEND_WEIGHT=0.5
RASTER_MAX_UPLOAD_MB=150

# --- Developer login (local demos only; leave blank in production) ---------
# Lets you sign in as a seeded account without Google. Inert unless BOTH are
# set, and the token is compared in constant time. This is not a shared bypass:
# it resolves to one specific account whose farms are scoped by the same
# farmer_id filter as any Google user's. /healthz reports `dev_login_enabled`,
# so an instance running with this on is visible at a glance.
#   python -m scripts.seed_demo      # creates the demo account + 3 real farms
DEV_LOGIN_USER=
DEV_LOGIN_TOKEN=

# --- Model / quantum runtime ---
MODEL_VERSION=v1
QAOA_TIMEOUT_S=10.0
# Legacy transverse-field QAOA — kept as the measured baseline SPARQ is
# compared against on every /plan call. Not the solver that serves the plan.
QAOA_LAYERS=3
ENCODING=slack

# --- SPARQ (Simplex-Preserving Adaptive Risk-aware QAOA) ---
# Primary solver. The XY-ring mixer conserves Hamming weight per plot block, so
# one-crop-per-plot holds by construction and no qubits are spent on slack.
SOLVER=sparq
SPARQ_LAYERS=3
# Softmax temperature on the LightGBM net-value matrix when warm-starting each
# plot's block. Lower = more concentrated on the model's favourite crop; higher
# tends to the uniform W state, i.e. no warm start at all.
SPARQ_WARM_START_TAU=0.35
SPARQ_MAXITER_PER_LAYER=60
SPARQ_SHOTS=2048
# Run the legacy QAOA alongside SPARQ so the head-to-head is live. It is the
# slowest thing on the critical path — set false if a slow machine puts the
# 8s p95 plan budget (NFR-02) at risk. The plan never depends on it.
RUN_BASELINE_QAOA=true

# --- Risk model ---
# kappa: mean-variance trade-off. 0 maximises expected rupees (and will put one
# crop on every plot); higher pays expected value for a tighter profit spread.
# Farmer-overridable per request via the plan payload's `risk_aversion`.
RISK_KAPPA=0.35
RISK_SCENARIOS=256
# Correlation between different crops' yields in one field — they share one
# monsoon. Same crop on two plots is always 1.0, which is what drives
# diversification. An assumption a judge is entitled to interrogate.
RISK_CROSS_CROP_RHO=0.45
# Reported CVaR tail fraction. Reported only — CVaR is not quadratic in the
# decisions, so the QUBO encodes the mean-variance surrogate instead.
RISK_CVAR_BETA=0.2
